# ==============================================================================
# 短视频去水印解析 API - 环境变量配置
# ==============================================================================

# Flask 密钥，用于 session 安全签名
SECRET_KEY=change_this_to_a_random_secret_key

# 服务对外的基础域名 (用于生成可访问的下载链接)
DOMAIN=

# 小红书登录 Cookie (解析小红书链接必备)
# 在浏览器登录小红书后，从请求头中复制 Cookie 值（包含 a1 字段）
XIAOHONGSHU_COOKIE=a1=your_a1_cookie_value_here; webId=your_web_id_here
