# ==============================================================================
# 短视频去水印解析 API - 环境变量配置
# ==============================================================================

# Flask 密钥，用于 session 安全签名
SECRET_KEY=change_this_to_a_random_secret_key

# 服务对外的基础域名 (B站解析需要，用于生成可访问的下载链接)
DOMAIN=

# 小红书登录 Cookie（解析小红书链接必备）
# 获取方式：浏览器登录 xiaohongshu.com → F12 → Network → 复制 Cookie 请求头
# 关键字段：a1, webId
XIAOHONGSHU_COOKIE=a1=your_a1_cookie_value_here; webId=your_web_id_here

# 快手登录 Cookie（提高解析成功率）
# 获取方式：浏览器登录 kuaishou.com → F12 → Network → 复制 Cookie 请求头
# 非必需，不设置时使用内置默认 Cookie，但解析成功率可能降低
KUAISHOU_COOKIE=kpf=PC_WEB; clientid=3; userId=your_user_id_here
